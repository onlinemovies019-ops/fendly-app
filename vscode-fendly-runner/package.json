{
    "name": "fendly-device-runner",
    "displayName": "Fendly Device Runner",
    "description": "Reconnect Redmi over Wi-Fi and build, install, and launch Fendly from VS Scrcpy.",
    "version": "0.1.7",
    "publisher": "fendly",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:fendly.runOnDevice",
        "onCommand:fendly.reconnectWifiAdb",
        "onCommand:fendly.refreshScrcpyMirror",
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "fendly.runOnDevice",
                "title": "Build, Install & Run Fendly",
                "icon": "$(play)"
            },
            {
                "command": "fendly.reconnectWifiAdb",
                "title": "Reconnect Fendly over Wi-Fi",
                "icon": "$(refresh)"
            },
            {
                "command": "fendly.refreshScrcpyMirror",
                "title": "Refresh Scrcpy Mirror",
                "icon": "$(debug-restart)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "fendly.runOnDevice",
                    "when": "view == scrcpySidebar",
                    "group": "navigation@1"
                },
                {
                    "command": "fendly.reconnectWifiAdb",
                    "when": "view == scrcpySidebar",
                    "group": "navigation@2"
                },
                {
                    "command": "fendly.refreshScrcpyMirror",
                    "when": "view == scrcpySidebar",
                    "group": "navigation@3"
                }
            ]
        }
    }
}
