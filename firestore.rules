rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /verified_emails/{email} {
      allow read, write: if request.auth != null;
    }
    match /found_items/{itemId} {
      allow read, write: if request.auth != null;
    }
    match /lost_items/{itemId} {
      allow read, write: if request.auth != null;
    }
  }
}
